    "A longer rest every few cycles, so your body gets a real reset too.": {
      "comment": "Break schedule row title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A longer rest every few cycles, so your body gets a real reset too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un descanso más largo cada pocos ciclos, para que tu cuerpo también se recupere de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pause plus longue tous les quelques cycles, pour que votre corps récupère vraiment aussi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle paar Zyklen eine längere Pause, damit sich auch dein Körper richtig erholt."
          }
        }
      }
    },
