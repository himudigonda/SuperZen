        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A mitad de frase? SuperZen espera hasta %@ mientras escribes. Alejarte también cuenta como pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pleine phrase ? SuperZen attend jusqu'à %@ pendant que vous tapez. S'éloigner compte aussi comme une pause."
