          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes all sessions, breaks, wellness events, and per-app work-block data. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todas las sesiones, descansos, eventos de bienestar y datos de apps por bloque de trabajo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement toutes les sessions, pauses, événements de bien-être et données d'applis par bloc de travail. Cette action est irréversible."
