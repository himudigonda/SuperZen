    "Changes save as you make them. The floating nudge follows your cursor and starts the break when the timer reaches zero.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes save as you make them. The floating nudge follows your cursor and starts the break when the timer reaches zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan al hacerlos. El aviso flotante sigue al cursor e inicia la pausa cuando el temporizador llega a cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont enregistrées au fur et à mesure. L'avertissement flottant suit votre curseur et lance la pause quand le minuteur atteint zéro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden sofort gespeichert. Der schwebende Hinweis folgt deinem Cursor und startet die Pause, wenn der Timer null erreicht."
          }
        }
      }
    },
