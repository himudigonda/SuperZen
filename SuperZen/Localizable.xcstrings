    "The heads-up comes before the break starts, so it must be shorter than the focus block.": {
      "comment": "Settings validation message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heads-up comes before the break starts, so it must be shorter than the focus block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso llega antes de que empiece la pausa, así que debe ser más corto que el bloque de concentración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'avertissement arrive avant le début de la pause, il doit donc être plus court que le bloc de concentration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hinweis kommt vor Beginn der Pause und muss daher kürzer als der Fokusblock sein."
          }
        }
      }
    },
    "The screen softens for %@. Look away and let your eyes rest.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen softens for %@. Look away and let your eyes rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se atenúa durante %@. Aparta la vista y deja descansar tus ojos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran s'adoucit pendant %@. Détournez le regard et reposez vos yeux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird für %@ gedämpft. Schau weg und lass deine Augen ruhen."
          }
        }
      }
    },
    "The work you do in quiet moments defines you.": {
      "comment": "Wellness overlay affirmation sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The work you do in quiet moments defines you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo que haces en los momentos de calma te define."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail accompli dans les moments de calme vous définit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeit, die Sie in stillen Momenten leisten, definiert Sie."
          }
        }
      }
    },
    "This key can't be used for a shortcut.": {
      "comment": "Shortcut issue",
      "extractionState": "manual",
      "localizations": {
