          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla no se puede usar en un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette touche ne peut pas être utilisée pour un raccourci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Taste kann nicht für einen Kurzbefehl verwendet werden."
          }
        }
      }
    },
    "This permanently removes every focus session, break, wellness reminder and app usage record. Your settings stay as they are. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes every focus session, break, wellness reminder and app usage record. Your settings stay as they are. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina para siempre todas las sesiones de concentración, pausas, recordatorios de bienestar y registros de uso de apps. Tus ajustes no cambian. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement toutes les sessions de concentration, pauses, rappels de bien-être et données d'utilisation des apps. Vos réglages restent inchangés. Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Fokussitzungen, Pausen, Wohlfühl-Erinnerungen und App-Nutzungsdaten dauerhaft gelöscht. Deine Einstellungen bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
